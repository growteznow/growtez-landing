// Firebase Firestore Security Rules for Growtez Blog
// Copy these rules to: Firebase Console > Firestore Database > Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin whitelist (named users via Google OAuth) ───────────────────────
    function isNamedAdmin() {
      return request.auth != null && request.auth.token.email in [
        "contact@growtez.com",
        "contact.growtez@gmail.com",
        "exkrogroup@gmail.com",
        "souravsharma13here@gmail.com",
        "mridulroy543@gmail.com",
        "faruk.khan.cse@gmail.com",
        "ahmedsanjeev37@gmail.com",
        "roy.mridul.cse@gmail.com"
      ];
    }

    // ── Anonymous auth (used by the Growtez Admin Panel) ────────────────────
    // The admin panel uses Firebase anonymous sign-in as a lightweight auth
    // token so the Firestore client SDK works. All real access control is
    // handled by Supabase in the admin app.
    function isAnonymousAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function canWrite() {
      return isNamedAdmin() || isAnonymousAdmin();
    }

    // ── Portfolio ────────────────────────────────────────────────────────────
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if canWrite();
    }

    // ── Blog Posts ───────────────────────────────────────────────────────────
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if canWrite();
    }

    // ── Contacts ─────────────────────────────────────────────────────────────
    match /contacts/{contactId} {
      // Anyone can submit a contact form
      allow create: if true;
      // Admin panel (anonymous) or named admin can read/update/delete
      allow read, update, delete: if canWrite();
    }

    // ── Internships ──────────────────────────────────────────────────────────
    match /internships/{internshipId} {
      // Anyone can submit an application
      allow create: if true;
      // Admin panel (anonymous) or named admin can read/update/delete
      allow read, update, delete: if canWrite();
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
